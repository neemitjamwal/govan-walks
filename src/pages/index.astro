---
import Base from '../layouts/Base.astro';
import WalkCard from '../components/WalkCard.astro';
import { walks } from '../data/walks';
---

<Base>
  <section class="map-frame px-5 py-8 text-center">
    <p class="map-label m-0">Self-guided heritage walks</p>
    <h1 class="map-title my-2">Govan Walks</h1>
    <p class="mx-auto max-w-prose text-ink-soft">
      Govan began at an ancient ford over the Clyde. Govan Old has been a Christian site since roughly AD 500, Isabella
      Elder gave Govan its park in 1885, and ships are still built on the very same site at Fairfield.
    </p>
    <p class="mx-auto max-w-prose text-ink-soft">
      Walk it with your phone. Each stop has a short story from The Govan Atlas, a picture from an old map of the spot,
      live directions to the next stop, and a button that reads the story aloud.
    </p>
  </section>

  <section class="mt-8" aria-labelledby="walks-heading">
    <h2 id="walks-heading" class="text-2xl">Choose a walk</h2>
    <ul class="walk-cards">
      {walks.map((walk, i) => <WalkCard walk={walk} sheet={i + 1} />)}
    </ul>
  </section>
</Base>
