---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const siteName = 'Govan Walks';
const { title, description = 'Self-guided heritage walks around Govan, Glasgow, for your phone.' } = Astro.props;
const pageTitle = title ? `${title} · ${siteName}` : siteName;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f3ead7" />
    <title>{pageTitle}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Libre+Caslon+Text:ital,wght@0,400;0,700;1,400&family=Source+Sans+3:wght@400;600;700&display=swap"
    />
    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-2 focus:top-2 focus:z-50 btn">Skip to content</a>
    <header class="mx-auto max-w-3xl px-4 pt-4">
      <div class="map-frame flex items-center justify-between gap-3 px-3 py-2">
        <a href={base} class="flex items-center gap-2 text-ink no-underline hover:text-survey-dark" aria-label="Govan Walks home">
          <svg class="north-arrow" viewBox="0 0 32 32" aria-hidden="true">
            <circle cx="16" cy="16" r="14" fill="none" stroke="currentColor" stroke-width="1" />
            <path d="M16 4 L21 22 L16 18 L11 22 Z" fill="currentColor" />
            <path d="M16 4 L16 18 L11 22 Z" fill="#f3ead7" stroke="currentColor" stroke-width="0.75" />
            <text x="16" y="30.5" text-anchor="middle" font-size="6" font-family="serif" fill="currentColor">N</text>
          </svg>
          <span class="font-display text-xl tracking-wide">{siteName}</span>
        </a>
        <nav aria-label="Site">
          <ul class="m-0 flex list-none gap-4 p-0">
            <li><a href={base} class="map-label no-underline hover:text-survey-dark">Home</a></li>
            <li><a href={`${base}credits/`} class="map-label no-underline hover:text-survey-dark">Credits</a></li>
          </ul>
        </nav>
      </div>
    </header>

    <main id="main" class="mx-auto max-w-3xl px-4 py-6">
      <slot />
    </main>

    <footer class="mx-auto max-w-3xl px-4 pb-8">
      <hr class="neat-line" />
      <p class="text-sm text-ink-soft">
        Stories from <a href="https://github.com/neemitjamwal/govan">The Govan Atlas</a>. Map data
        © <a href="https://www.openstreetmap.org/copyright">OpenStreetMap contributors</a>. Historic maps are public domain,
        via Wikimedia Commons. <a href={`${base}credits/`}>Full credits</a>.
      </p>
    </footer>
  </body>
</html>
