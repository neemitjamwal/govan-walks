---
import type { Stop } from '../data/stops';

interface Props {
  stop: Stop;
}

const { stop } = Astro.props;
const base = import.meta.env.BASE_URL;
---

{
  stop.then ? (
    <figure class="then-figure">
      <img
        src={`${base}${stop.then.src.replace(/^\//, '')}`}
        width="1000"
        height="750"
        loading="lazy"
        decoding="async"
        alt={`Detail of an old map around ${stop.name}, with a ring marking the stop.`}
      />
      <figcaption>
        {stop.then.caption}{' '}
        <a href={stop.then.creditUrl}>{stop.then.credit}</a>
      </figcaption>
    </figure>
  ) : (
    <div class="then-missing" role="note">
      <p class="map-label m-0">No historic map covers this spot</p>
      <p class="m-0">{stop.thenUnavailable}</p>
    </div>
  )
}
