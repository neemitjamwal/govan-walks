---

<div id="listen" class="listen" data-state="idle" data-speech-text="">
  <div class="listen-controls" hidden>
    <button type="button" id="listen-play" class="btn">
      <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M4 2 L13 8 L4 14 Z" fill="currentColor"></path></svg>
      Listen
    </button>
    <button type="button" id="listen-pause" class="btn" hidden>Pause</button>
    <button type="button" id="listen-stop" class="btn btn-quiet" hidden>Stop</button>
  </div>
  <p class="listen-note m-0">This browser can't read stories aloud, but the whole story is below to read.</p>
</div>
